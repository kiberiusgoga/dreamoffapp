# Copy to .env.local to enable ads in a local build. Both must be set;
# with either missing the app loads no ad script and renders no ad slots.
#
# Values come from your Google AdSense dashboard.
# The publisher id is validated: it must be "ca-pub-" plus 16 digits.

VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
VITE_ADSENSE_SLOT_HOME=0000000000
