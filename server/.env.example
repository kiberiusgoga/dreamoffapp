# Copy to server/.env and fill in. The server refuses to start if JWT_SECRET
# is missing or still set to the placeholder below.

PORT=5000

# development | production
# Controls CORS and the startup banner. `npm start` reads it from here —
# there is no NODE_ENV prefix in the npm script (that syntax breaks on Windows).
NODE_ENV=production

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here

# Token lifetime: "7d", "12h", "30m", ...
JWT_EXPIRES_IN=7d

# ── AI API Keys (optional) ──
# Without these the app runs, but /api/ai/interpret and /api/ai/image return 500.
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ── Rate limits ──
# Auth: attempts per window, successful sign-ins excluded.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# AI: per account, not per address. Each call costs money upstream.
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=3600000

# ── Deployment ──
# Point these at the mounted volume. The Dockerfile defaults them to /data.
DATABASE_PATH=/data/database.sqlite
UPLOADS_PATH=/data/uploads

# How long to let in-flight requests finish on SIGTERM.
SHUTDOWN_GRACE_MS=10000

# ── Logging ──
# debug | info | warn | error. Defaults to info in production, debug otherwise.
# Output is one JSON object per line on stdout; the host collects it.
LOG_LEVEL=info

# Gemini model. Names get retired — gemini-2.5-flash stopped accepting new
# users and returned a 404 that read like a broken key. Override here if the
# default is ever withdrawn too.
GEMINI_MODEL=gemini-3.6-flash

# ── Orphaned uploads ──
# An image is written before its dream exists, so an interrupted flow leaves a
# file nobody references. The grace period keeps the sweep from deleting one
# that is still on its way to a dream.
UPLOAD_SWEEP_GRACE_MS=86400000
UPLOAD_SWEEP_INTERVAL_MS=21600000

# ── Backups ──
# VACUUM INTO writes a consistent snapshot while the server keeps serving.
# Local, on the same volume: enough for a bad migration or a mistaken delete,
# not for losing the disk. Set the interval to 0 to switch them off.
BACKUP_INTERVAL_MS=21600000
BACKUP_KEEP=8
# BACKUP_DIR=/data/backups
